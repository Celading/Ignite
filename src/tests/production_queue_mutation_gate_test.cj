        )
        let rejectedDryRun = buildIgniteRuntimeDefaultPathMutationDryRunReceipt(
            rejectedGate,
            acceptedRuntimeDefaultPathMutationDryRunRequest()
        )
        let rejectedApplyGate =
            buildIgniteRuntimeDefaultPathMutationApplyGateReceipt(
