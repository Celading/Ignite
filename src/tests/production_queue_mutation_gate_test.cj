            2
        )
        @Assert(
            blockingReceipt.applyGateReceipt.dryRunReceipt.commitPlanReceipt.queueDepthAfter,
            3
        )
        @Assert(
            blockingReceipt.controlledDefaultEngineMutationApplyRecorded,
            true
        )
    }

